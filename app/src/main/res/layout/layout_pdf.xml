                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

        </TableRow>


        <TableRow>
            <TextView
                android:id="@+id/initEntrada1"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initLeitura1"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initErro1"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initFora1"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />
        </TableRow>

        <TableRow>
            <TextView
                android:id="@+id/initEntrada2"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initLeitura2"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initErro2"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initFora2"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />
        </TableRow>

        <TableRow>
            <TextView
                android:id="@+id/initEntrada3"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initLeitura3"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initErro3"
                android:padding="2dp"
