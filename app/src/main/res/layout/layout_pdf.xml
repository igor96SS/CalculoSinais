                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initFora3"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />
        </TableRow>

        <TableRow>
            <TextView
                android:id="@+id/initEntrada4"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initLeitura4"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initErro4"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initFora4"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />
        </TableRow>


    </TableLayout>

    <!-- ===== VERIFICAÇÃO FINAL (5 linhas) ===== -->
    <TextView
        android:id="@+id/tvVerifFinal2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verificação Final"
        android:textStyle="bold"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/tabelaInicial"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp" />

    <TableLayout
        android:id="@+id/tabelaFinal2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        app:layout_constraintTop_toBottomOf="@id/tvVerifFinal2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp">

        <TableRow>
            <TextView
                android:text="Valor Entrada"
                android:padding="4dp"
                android:textStyle="bold"
                android:textSize="9sp"
                />

            <TextView
                android:text="Valor Leitura"
                android:padding="4dp"
