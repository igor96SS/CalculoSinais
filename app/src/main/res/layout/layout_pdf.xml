<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"

    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- ESPAÇO PARA LOGO (200dp de altura) -->
    <FrameLayout
        android:id="@+id/logoArea"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Logo"
            android:layout_gravity="start|top"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:paddingTop="4dp"/>

        <!-- Mantemos espaço vazio ao lado do logo para visualizar a área -->
    </FrameLayout>

    <!-- ===== 4 LINHAS DA MORADA (ALINHADAS À ESQUERDA) ===== -->
    <TextView
        android:id="@+id/lineAddress1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 1"
        android:textSize="10sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/logoArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/lineAddress2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 2"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/lineAddress1"
        app:layout_constraintStart_toStartOf="@id/lineAddress1"
        app:layout_constraintEnd_toEndOf="@id/lineAddress1"
        android:layout_marginTop="2dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/lineAddress3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 3"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/lineAddress2"
        app:layout_constraintStart_toStartOf="@id/lineAddress2"
        app:layout_constraintEnd_toEndOf="@id/lineAddress2"
        android:layout_marginTop="2dp"
        android:gravity="start" />

    <TextView
        android:id="@+id/lineAddress4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 4"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/lineAddress3"
        app:layout_constraintStart_toStartOf="@id/lineAddress3"
        app:layout_constraintEnd_toEndOf="@id/lineAddress3"
        android:layout_marginTop="2dp"
        android:gravity="start" />

    <!-- ===== TÍTULO CENTRAL ===== -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ficha de Calibração"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/lineAddress4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp" />

    <!-- guideline vertical centro -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- ===== COLUNA ESQUERDA ===== -->
    <TextView
        android:id="@+id/labelCliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cliente:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelCliente"
        app:layout_constraintBaseline_toBaselineOf="@id/labelCliente"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelEquipamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Equipamento:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelCliente"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvEquipamento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelEquipamento"
        app:layout_constraintBaseline_toBaselineOf="@id/labelEquipamento"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelDescricao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelEquipamento"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelDescricao"
        app:layout_constraintBaseline_toBaselineOf="@id/labelDescricao"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelMarca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marca:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelDescricao"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvMarca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelMarca"
        app:layout_constraintBaseline_toBaselineOf="@id/labelMarca"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelModelo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modelo:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelMarca"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvModelo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelModelo"
        app:layout_constraintBaseline_toBaselineOf="@id/labelModelo"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <!-- ===== COLUNA DIREITA ===== -->
    <TextView
        android:id="@+id/labelObra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obra:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
