<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="595dp"
    android:layout_height="842dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="match_parent"
    tools:layout_width="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Logo no topo -->
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:contentDescription="Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Morada / Endereço (4 linhas) -->
    <TextView
        android:id="@+id/lineAddress1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 1"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/imageLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lineAddress2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 2"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/lineAddress1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lineAddress3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 3"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/lineAddress2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lineAddress4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Morada linha 4"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/lineAddress3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título central -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ficha de Calibração"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/lineAddress4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- Guideline para dividir colunas -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Coluna esquerda: Cliente, Equipamento, Descrição, Marca, Modelo -->
    <TextView
        android:id="@+id/labelCliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cliente:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelCliente"
        app:layout_constraintBaseline_toBaselineOf="@id/labelCliente"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelEquipamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Equipamento:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelCliente"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvEquipamento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelEquipamento"
        app:layout_constraintBaseline_toBaselineOf="@id/labelEquipamento"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelDescricao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrição:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelEquipamento"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelDescricao"
        app:layout_constraintBaseline_toBaselineOf="@id/labelDescricao"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelMarca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marca:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelDescricao"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvMarca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelMarca"
        app:layout_constraintBaseline_toBaselineOf="@id/labelMarca"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <TextView
        android:id="@+id/labelModelo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modelo:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelMarca"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvModelo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelModelo"
        app:layout_constraintBaseline_toBaselineOf="@id/labelModelo"
        app:layout_constraintEnd_toStartOf="@id/guidelineCenter" />

    <!-- Coluna direita: Obra, Data, TAG, Nº Série, Gama Entrada, Gama Saída, Erro Máx -->
    <TextView
        android:id="@+id/labelObra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Obra:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvObra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelObra"
        app:layout_constraintBaseline_toBaselineOf="@id/labelObra"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelObra"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelData"
        app:layout_constraintBaseline_toBaselineOf="@id/labelData"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAG / Identificação:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelData"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvTag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelTag"
        app:layout_constraintBaseline_toBaselineOf="@id/labelTag"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelSerie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N.º Série:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelTag"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvSerie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelSerie"
        app:layout_constraintBaseline_toBaselineOf="@id/labelSerie"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelGamaEntrada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gama de serviço – Entrada:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelSerie"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvGamaEntrada1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelGamaEntrada"
        app:layout_constraintBaseline_toBaselineOf="@id/labelGamaEntrada"
        app:layout_constraintEnd_toStartOf="@id/tvGamaEntrada2" />

    <TextView
        android:id="@+id/tvGamaEntrada2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:gravity="end"
        android:textSize="12sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tvGamaEntrada1"
        app:layout_constraintBaseline_toBaselineOf="@id/tvGamaEntrada1"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelGamaSaida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gama de serviço – Saída:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelGamaEntrada"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvGamaSaida1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelGamaSaida"
        app:layout_constraintBaseline_toBaselineOf="@id/labelGamaSaida"
        app:layout_constraintEnd_toStartOf="@id/tvGamaSaida2" />

    <TextView
        android:id="@+id/tvGamaSaida2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:gravity="end"
        android:textSize="12sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tvGamaSaida1"
        app:layout_constraintBaseline_toBaselineOf="@id/tvGamaSaida1"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelErroMax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Erro Máx. % (F. Esc.):"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelGamaSaida"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvErroMax"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/labelErroMax"
        app:layout_constraintBaseline_toBaselineOf="@id/labelErroMax"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Função (checkboxes) -->
    <TextView
        android:id="@+id/labelFuncao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Função:"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModelo"
        android:layout_marginTop="20dp" />

    <CheckBox
        android:id="@+id/cbLinear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Linear"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/labelFuncao"
        app:layout_constraintStart_toEndOf="@id/labelFuncao"
        android:layout_marginStart="16dp" />

    <CheckBox
        android:id="@+id/cbQuadratica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quadrática"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/labelFuncao"
        app:layout_constraintStart_toEndOf="@id/cbLinear"
        android:layout_marginStart="8dp" />

    <CheckBox
        android:id="@+id/cbTermopar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Termopar"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/labelFuncao"
        app:layout_constraintStart_toEndOf="@id/cbQuadratica"
        android:layout_marginStart="8dp" />

    <!-- Tabela Verificação Inicial -->
    <TextView
        android:id="@+id/tvVerifInicial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verificação Inicial"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/labelFuncao"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TableLayout
        android:id="@+id/tabelaInicial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvVerifInicial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow>
            <TextView android:text="Valor" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Padrão" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Saída Eq." android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Erro" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Limite" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/padrao0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/saida0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/erro0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/limite0" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="25" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/padrao25" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/saida25" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/erro25" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/limite25" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/padrao50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/saida50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/erro50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/limite50" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="75" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/padrao75" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/saida75" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/erro75" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/limite75" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/padrao100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/saida100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/erro100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/limite100" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>
    </TableLayout>

    <!-- Tabela Verificação Final -->
    <TextView
        android:id="@+id/tvVerifFinal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verificação Final"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tabelaInicial"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TableLayout
        android:id="@+id/tabelaFinal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvVerifFinal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow>
            <TextView android:text="Valor" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Padrão" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Saída Eq." android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Erro" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Limite" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalPadrao0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalSaida0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalErro0" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalLimite0" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalPadrao50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalSaida50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalErro50" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalLimite50" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:text="100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalPadrao100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalSaida100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalErro100" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/finalLimite100" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>
    </TableLayout>

    <!-- Equipamento padrão utilizado -->
    <TextView
        android:id="@+id/tvEquipPadrao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Equipamento Padrão Utilizado"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tabelaFinal"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TableLayout
        android:id="@+id/tabelaEquipPadrao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvEquipPadrao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow>
            <TextView android:text="Marca" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="Modelo" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="N.º Série" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:text="N.º Património" android:padding="6dp" android:textStyle="bold" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:id="@+id/eq1Marca" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq1Modelo" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq1Serie" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq1Patrimonio" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:id="@+id/eq2Marca" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq2Modelo" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq2Serie" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq2Patrimonio" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

        <TableRow>
            <TextView android:id="@+id/eq3Marca" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq3Modelo" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq3Serie" android:padding="6dp" android:textSize="12sp"/>
            <TextView android:id="@+id/eq3Patrimonio" android:padding="6dp" android:textSize="12sp"/>
        </TableRow>

    </TableLayout>

    <!-- Observações -->
    <TextView
        android:id="@+id/tvObsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Observações"
        android:textStyle="bold"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tabelaEquipPadrao"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvObservacoes"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:text=""
        android:textSize="12sp"
        android:padding="6dp"
        android:background="#00000000"
        app:layout_constraintTop_toBottomOf="@id/tvObsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Rodapé: Verificado | Técnico | Responsável -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvVerificadoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificado"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVerificadoNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVerificadoAssinatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assinatura"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvTecnicoLabelFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Técnico"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTecnicoNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTecnicoAssinatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assinatura"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvResponsavelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responsável"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvResponsavelNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvResponsavelData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>