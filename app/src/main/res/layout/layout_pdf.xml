        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelObra"
        app:layout_constraintBaseline_toBaselineOf="@id/labelObra"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelObra"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelData"
        app:layout_constraintBaseline_toBaselineOf="@id/labelData"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TAG / Identificação:"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@id/tvDescricao"
        app:layout_constraintTop_toBottomOf="@id/labelData" />

    <TextView
        android:id="@+id/tvTag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelTag"
        app:layout_constraintBaseline_toBaselineOf="@id/labelTag"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelSerie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="N.º Série:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/labelObra"
        app:layout_constraintTop_toBottomOf="@id/labelTag"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvSerie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelSerie"
        app:layout_constraintBaseline_toBaselineOf="@id/labelSerie"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== GAMA DE SERVIÇO (entrada / saída) ===== -->
    <TextView
        android:id="@+id/labelGamaServico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gama de\nserviço"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@+id/labelSerie" />

    <TextView
        android:id="@+id/labelEntrada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Entrada"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/labelSerie"
        app:layout_constraintStart_toStartOf="@+id/labelSerie"
        app:layout_constraintTop_toBottomOf="@+id/labelSerie" />

    <TextView
        android:id="@+id/tvEntrada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelEntrada"
        app:layout_constraintBaseline_toBaselineOf="@id/labelEntrada"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelSaida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Saida"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/labelEntrada"
        app:layout_constraintStart_toStartOf="@+id/labelEntrada"
        app:layout_constraintTop_toBottomOf="@+id/labelEntrada" />

    <TextView
        android:id="@+id/tvSaida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelSaida"
        app:layout_constraintBaseline_toBaselineOf="@id/labelSaida"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelErroMax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Erro Máx.% (F.Esc.)"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/labelSaida"
        app:layout_constraintTop_toBottomOf="@+id/labelSaida" />

    <TextView
        android:id="@+id/tvErroMax"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/labelErroMax"
        app:layout_constraintBaseline_toBaselineOf="@id/labelErroMax"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== FUNÇÃO (checkboxes) ===== -->
    <!--
    <TextView
        android:id="@+id/tvGamaServico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text=""
        android:textSize="10sp"
        app:layout_constraintBaseline_toBaselineOf="@id/labelGamaServico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/labelGamaServico" />

        -->

    <TextView
        android:id="@+id/labelFuncao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Função:"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelErroMax"
        app:layout_constraintStart_toEndOf="@id/labelErroMax"
        />

    <CheckBox
        android:id="@+id/cbLinear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Linear"
        android:textSize="10sp"
        app:layout_constraintBaseline_toBaselineOf="@id/labelFuncao"
        app:layout_constraintStart_toEndOf="@id/labelFuncao"
        android:layout_marginStart="8dp" />

    <CheckBox
        android:id="@+id/cbQuadratica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quadrática"
        android:textSize="10sp"
        app:layout_constraintBaseline_toBaselineOf="@id/labelFuncao"
        app:layout_constraintStart_toEndOf="@id/cbLinear"
        android:layout_marginStart="8dp" />

    <CheckBox
        android:id="@+id/cbTermopar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Termopar"
        android:textSize="10sp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="@id/cbQuadratica"
        app:layout_constraintTop_toBottomOf="@+id/cbQuadratica" />

    <!-- ===== VERIFICAÇÃO INICIAL (5 linhas) ===== -->
    <TextView
        android:id="@+id/tvVerifInicial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verificação Inicial"
        android:textStyle="bold"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/cbTermopar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp" />

    <TableLayout
        android:id="@+id/tabelaInicial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        app:layout_constraintTop_toBottomOf="@id/tvVerifInicial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp">

        <TableRow
            android:background="@drawable/cell_border_bold">
            <TextView
                android:text="Valor Entrada"
                android:padding="4dp"
                android:textStyle="bold"
                android:textSize="9sp"
                />
            <TextView android:text="Valor Leitura" android:padding="4dp" android:textStyle="bold" android:textSize="9sp"/>
            <TextView android:text="Erro" android:padding="4dp" android:textStyle="bold" android:textSize="9sp"/>
            <TextView android:text="Fora Gama?" android:padding="4dp" android:textStyle="bold" android:textSize="9sp"/>
        </TableRow>

        <!-- 5 linhas -->
        <TableRow>

            <TextView
                android:id="@+id/initEntrada0"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/initLeitura0"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
