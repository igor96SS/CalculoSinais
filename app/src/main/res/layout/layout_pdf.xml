                android:textStyle="bold"
                android:textSize="9sp"
                />

            <TextView
                android:text="Fora Gama?"
                android:padding="4dp"
                android:textStyle="bold"
                android:textSize="9sp"
                />

        </TableRow>

        <!-- 5 linhas -->
        <TableRow>
            <TextView
                android:id="@+id/finalEntrada0"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
