                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/finalFora0"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />
        </TableRow>

        <TableRow>
            <TextView
                android:id="@+id/finalEntrada1"
                android:padding="2dp"
                android:minHeight="16dp"
                android:textSize="8sp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/finalLeitura1"
